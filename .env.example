APP_NAME="Fashion House Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/fashion/public
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Use a NEW, empty database for the fashion app.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fashion_house
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Tenancy ────────────────────────────────────────────────────────────
# multi  = SaaS, many fashion houses on one installation
# single = one fashion house per installation (no switcher, no platform screens)
TENANCY_MODE=multi
TENANCY_DEFAULT_TENANT=default
TENANCY_SELF_SIGNUP=true
TENANCY_TRIAL_DAYS=14

# Subscriptions (multi-house mode). Plans are edited at /platform/plans.
BILLING_ENABLED=true
BILLING_TRIAL_PLAN=pro
BILLING_GRACE_DAYS=7
PLATFORM_PAYSTACK_PUBLIC_KEY=
PLATFORM_PAYSTACK_SECRET_KEY=
# Paystack dashboard webhook URL for the platform account: {APP_URL}/webhooks/billing/paystack

# Sign in with Google: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Public landing page (/). Leave the app links empty until the demo builds are out.
LANDING_BRAND="Fashion House Platform"
LANDING_ANDROID_URL=
LANDING_IOS_URL=
LANDING_APP_IS_DEMO=true
LANDING_CONTACT_EMAIL=
LANDING_CONTACT_PHONE=
TENANT_DEFAULT_TIMEZONE=Africa/Lagos
TENANT_DEFAULT_CURRENCY=NGN

# ── First fashion house + owner (used by `php artisan db:seed`) ────────
FHMP_HOUSE_NAME="My Fashion House"
FHMP_ADMIN_NAME="House Owner"
FHMP_ADMIN_EMAIL=admin@fashionhouse.test
FHMP_ADMIN_PASSWORD=password

# ── Integrations (fill in when the modules that use them are built) ────
PAYSTACK_ACTIVE=false
PAYSTACK_MODE=sandbox
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FCM_ENABLED=false
